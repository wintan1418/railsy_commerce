<%= form_with model: [:admin, flash_sale], class: "space-y-6" do |form| %>
  <% if flash_sale.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="text-sm text-red-800">
        <% flash_sale.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Name <span class="text-red-500">*</span></label>
      <%= form.text_field :name, required: true, placeholder: "Weekend Mega Sale", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Description</label>
      <%= form.text_area :description, rows: 2, placeholder: "Short pitch shown on the homepage", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Starts at <span class="text-red-500">*</span></label>
        <%= form.datetime_local_field :starts_at, value: flash_sale.starts_at&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Ends at <span class="text-red-500">*</span></label>
        <%= form.datetime_local_field :ends_at, value: flash_sale.ends_at&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Discount %</label>
        <%= form.number_field :discount_percentage, min: 0, max: 100, step: 1, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
        <p class="mt-1 text-xs text-gray-400">Applied to all selected products unless overridden.</p>
      </div>
      <div class="flex items-center pt-6">
        <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <label class="ml-2 text-sm font-medium text-gray-700">Active</label>
      </div>
    </div>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-semibold text-gray-900">Products in this sale</h3>
      <span class="text-xs text-gray-400"><%= @products.size %> available</span>
    </div>

    <input type="text" placeholder="Search products..." class="mb-3 block w-full rounded-lg border-gray-300 text-sm"
           oninput="const q=this.value.toLowerCase(); document.querySelectorAll('[data-product-row]').forEach(r=>{r.style.display = r.dataset.productName.includes(q) ? '' : 'none';});">

    <div class="max-h-96 overflow-y-auto rounded-lg border border-gray-200 divide-y divide-gray-100">
      <% selected_ids = flash_sale.product_ids %>
      <% @products.each do |product| %>
        <label data-product-row data-product-name="<%= product.name.downcase %>" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "flash_sale[product_ids][]", product.id, selected_ids.include?(product.id), class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          <% if product.images.attached? %>
            <%= image_tag product.images.first, class: "h-10 w-10 rounded object-cover ring-1 ring-gray-200" %>
          <% else %>
            <div class="h-10 w-10 rounded bg-gray-100"></div>
          <% end %>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate"><%= product.name %></p>
            <p class="text-xs text-gray-500"><%= product.display_price %></p>
          </div>
        </label>
      <% end %>
    </div>
    <%= hidden_field_tag "flash_sale[product_ids][]", "" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_flash_sales_path, class: "rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-200 hover:bg-gray-50" %>
    <%= form.submit class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
