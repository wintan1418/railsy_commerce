          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em]" style="color: var(--gold);">Your History</p>
            <h2 class="mt-3 font-display text-3xl font-light tracking-tight sm:text-4xl" style="color: var(--black);">Recently <em class="italic">Viewed</em></h2>
          </div>
          <%= link_to "View all", products_path, class: "hidden sm:inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-200 hover:opacity-70", style: "color: var(--gold);" %>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
          <% @recently_viewed.each do |product| %>
            <%= render "storefront/products/product_card", product: product %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
