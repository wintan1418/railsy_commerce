<%= form_with model: [:admin, banner], class: "space-y-6" do |form| %>
  <% if banner.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="text-sm text-red-800">
        <% banner.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Eyebrow</label>
      <%= form.text_field :eyebrow, placeholder: "Premium Marketplace", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      <p class="mt-1 text-xs text-gray-400">Small uppercase label above the title</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Title <span class="text-red-500">*</span></label>
      <%= form.text_field :title, required: true, placeholder: "Discover What's Next", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Subtitle</label>
      <%= form.text_area :subtitle, rows: 2, placeholder: "From cutting-edge tech to timeless home essentials...", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Button text</label>
        <%= form.text_field :link_text, placeholder: "Shop Now", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Button link</label>
        <%= form.text_field :link_url, placeholder: "/products", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
    </div>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <h3 class="text-sm font-semibold text-gray-900">Background image</h3>
    <% if banner.image.attached? %>
      <div class="flex items-center gap-4">
        <%= image_tag banner.image, class: "h-24 w-40 rounded-lg object-cover ring-1 ring-gray-200" %>
        <p class="text-xs text-gray-500">Upload a new file to replace.<br>Recommended: 1920×1080 or larger, JPG/WebP.</p>
      </div>
    <% end %>
    <%= form.file_field :image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <h3 class="text-sm font-semibold text-gray-900">Schedule & visibility</h3>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Start date</label>
        <%= form.datetime_local_field :starts_at, value: banner.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">End date</label>
        <%= form.datetime_local_field :ends_at, value: banner.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
    </div>
    <p class="text-xs text-gray-400">Leave both blank for an always-on banner.</p>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Position</label>
        <%= form.number_field :position, min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
        <p class="mt-1 text-xs text-gray-400">Lower numbers appear first</p>
      </div>
      <div class="flex items-center pt-6">
        <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <label class="ml-2 text-sm font-medium text-gray-700">Active</label>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_banners_path, class: "rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-200 hover:bg-gray-50" %>
    <%= form.submit class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
