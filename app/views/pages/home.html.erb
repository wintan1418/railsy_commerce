<div style="background: var(--warm-white);">
  <!-- ═══════════════════════════════════════════════════════════════════
       HERO - Banner-driven slideshow (admin-managed)
       ═══════════════════════════════════════════════════════════════════ -->
  <%
    hero_slides = if @banners.present?
      @banners.map do |b|
        {
          image: b.image.attached? ? url_for(b.image) : "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1920&q=80",
          eyebrow: b.eyebrow.presence || "Premium Marketplace",
          title: b.title,
          subtitle: b.subtitle,
          link_url: b.link_url.presence || products_path,
          link_text: b.link_text.presence || "Shop Now"
        }
      end
    else
      [
        { image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1920&q=80", eyebrow: "Premium Marketplace", title: "Discover What's Next", subtitle: "From cutting-edge tech to timeless home essentials — everything you need, beautifully curated and delivered to your door.", link_url: products_path, link_text: "Shop Now" },
        { image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=1920&q=80", eyebrow: "New Arrivals", title: "Sound Redefined", subtitle: "Premium audio gear from the brands audiophiles trust.", link_url: products_path, link_text: "Explore Audio" },
        { image: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=1920&q=80", eyebrow: "Home & Living", title: "Light Up Your Space", subtitle: "Modern lamps, decor, and essentials for every room.", link_url: products_path, link_text: "Shop Home" },
        { image: "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=1920&q=80", eyebrow: "Editor's Pick", title: "Crafted For You", subtitle: "Handpicked pieces that blend style and everyday utility.", link_url: products_path, link_text: "See Picks" }
      ]
    end
  %>
  <section class="relative overflow-hidden h-[70vh] sm:h-[80vh] lg:h-[88vh]" style="min-height: 520px; max-height: 1050px; background: var(--black);"
           data-controller="slideshow" data-slideshow-interval-value="5500"
           data-action="mouseenter->slideshow#pause mouseleave->slideshow#resume">

    <!-- Each slide has its own image + text content -->
    <% hero_slides.each_with_index do |slide, i| %>
      <div data-slideshow-target="slide" class="absolute inset-0 <%= i == 0 ? 'slide-active' : 'slide-inactive' %>">
        <!-- Background image (absolute so it doesn't push text out of view) -->
        <img src="<%= slide[:image] %>" alt="<%= slide[:title] %>" class="absolute inset-0 h-full w-full object-cover object-center hero-slide-img" loading="<%= i == 0 ? 'eager' : 'lazy' %>">

        <!-- Dark gradient overlays -->
        <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(8,8,8,0.92) 0%, rgba(8,8,8,0.7) 35%, rgba(8,8,8,0.4) 60%, rgba(8,8,8,0.25) 100%);"></div>
        <div class="absolute inset-0" style="background: linear-gradient(0deg, rgba(8,8,8,0.6) 0%, transparent 30%, transparent 85%, rgba(8,8,8,0.35) 100%);"></div>
        <div class="absolute inset-0 grain-overlay opacity-30"></div>

        <!-- Slide text content -->
        <div class="absolute inset-0 z-20 mx-auto flex h-full max-w-7xl items-center px-6 sm:px-8 lg:px-12">
          <div class="max-w-xl" style="animation: heroIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;">
            <div class="flex items-center gap-4">
              <span class="block h-px w-12" style="background: var(--gold);"></span>
              <span class="text-xs font-medium uppercase tracking-[0.35em]" style="color: var(--gold);"><%= slide[:eyebrow] %></span>
            </div>
            <h1 class="mt-7 font-display font-light leading-[1.05] tracking-tight text-white" style="font-size: clamp(2.5rem, 5vw, 5.5rem);">
              <%= slide[:title] %>
            </h1>
            <% if slide[:subtitle].present? %>
              <p class="mt-5 max-w-md text-[15px] leading-relaxed" style="color: rgba(255,255,255,0.65);">
                <%= slide[:subtitle] %>
              </p>
            <% end %>
            <div class="mt-7 sm:mt-9 flex flex-col gap-3 sm:gap-4 sm:flex-row">
              <%= link_to slide[:link_url], class: "group inline-flex items-center justify-center gap-3 px-8 sm:px-10 py-4 min-h-[48px] text-sm font-semibold uppercase tracking-[0.15em] transition-all duration-300 hover:opacity-90", style: "background: var(--gold); color: var(--black);" do %>
                <%= slide[:link_text] %>
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              <% end %>
              <%= link_to "Explore Categories", "#categories",
                class: "inline-flex items-center justify-center gap-3 border px-8 sm:px-10 py-4 min-h-[48px] text-sm font-semibold uppercase tracking-[0.15em] text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/10",
                style: "border-color: rgba(255,255,255,0.25);" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Slide indicators -->
    <div class="absolute bottom-8 left-1/2 z-30 flex -translate-x-1/2 items-center gap-2">
      <% hero_slides.each_with_index do |_, i| %>
        <button data-slideshow-target="dot" data-slide-index="<%= i %>" data-action="click->slideshow#goToSlide"
                class="h-2 cursor-pointer transition-all duration-500 <%= i == 0 ? 'dot-active' : 'dot-inactive' %>"
                aria-label="Slide <%= i + 1 %>"></button>
      <% end %>
    </div>

    <!-- Bottom Right: Stats with dividers -->
    <div class="absolute bottom-12 right-12 z-20 hidden lg:flex items-center gap-8" style="animation: heroIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;">
      <div class="text-right">
        <p class="font-display text-2xl font-semibold" style="color: var(--gold);">5k+</p>
        <p class="text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.3);">Products</p>
      </div>
      <div class="h-8 w-px" style="background: rgba(255,255,255,0.08);"></div>
      <div class="text-right">
        <p class="font-display text-2xl font-semibold" style="color: var(--gold);">200+</p>
        <p class="text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.3);">Brands</p>
      </div>
      <div class="h-8 w-px" style="background: rgba(255,255,255,0.08);"></div>
      <div class="text-right">
        <p class="font-display text-2xl font-semibold" style="color: var(--gold);">98%</p>
        <p class="text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.3);">Satisfaction</p>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 right-10 z-30 hidden animate-float lg:block">
      <a href="#categories" class="flex flex-col items-center gap-2" style="color: rgba(255,255,255,0.25);">
        <span class="text-[10px] font-medium uppercase tracking-[0.3em]" style="writing-mode: vertical-rl;">Scroll</span>
        <div class="h-8 w-px overflow-hidden" style="background: rgba(255,255,255,0.08);">
          <div class="h-full w-full" style="background: var(--gold); animation: scrollAnim 2s ease-in-out infinite;"></div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       TRUST BAR
       ═══════════════════════════════════════════════════════════════════ -->
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--warm-white) 100%);">
    <div class="mx-auto max-w-7xl px-6 py-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-2 gap-y-4 gap-x-6 lg:grid-cols-4">
        <% [
          { icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12", label: "Free Shipping", sub: "Orders over $75" },
          { icon: "M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182", label: "Easy Returns", sub: "30-day policy" },
          { icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z", label: "Secure Checkout", sub: "SSL encrypted" },
          { icon: "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155", label: "24/7 Support", sub: "Always here" }
        ].each do |item| %>
          <div class="trust-item flex items-center gap-3 cursor-default">
            <div class="flex h-10 w-10 items-center justify-center rounded-full flex-shrink-0" style="background: rgba(201,169,110,0.1);">
              <svg class="trust-icon h-5 w-5" style="color: var(--gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider block" style="color: var(--black);"><%= item[:label] %></span>
              <span class="text-[10px]" style="color: var(--mid-gray);"><%= item[:sub] %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       FLASH SALE - Time-boxed widget with countdown
       ═══════════════════════════════════════════════════════════════════ -->
  <% if @running_flash_sale && @running_flash_sale_products.any? %>
    <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #1a0a0f 0%, #2d0d17 50%, #1a0a0f 100%);">
      <div class="absolute inset-0 grain-overlay opacity-20"></div>
      <div class="relative mx-auto max-w-7xl px-6 py-14 sm:px-8 lg:px-12 lg:py-16"
           data-controller="countdown"
           data-countdown-ends-at-value="<%= @running_flash_sale.ends_at.iso8601 %>">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
          <div>
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white" style="background: #e11d48;">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white"></span>
                Live Now
              </span>
              <span class="text-[10px] font-medium uppercase tracking-[0.3em]" style="color: rgba(255,255,255,0.4);">Flash Sale</span>
            </div>
            <h2 class="mt-3 font-display text-3xl font-light leading-tight text-white sm:text-4xl lg:text-5xl">
              <%= @running_flash_sale.name %>
            </h2>
            <% if @running_flash_sale.description.present? %>
              <p class="mt-3 max-w-xl text-sm leading-relaxed" style="color: rgba(255,255,255,0.55);">
                <%= @running_flash_sale.description %>
              </p>
            <% end %>
          </div>

          <!-- Countdown -->
          <div class="flex items-center gap-3">
            <span class="text-[10px] font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.5);">Ends in</span>
            <% %w[days hours minutes seconds].each do |unit| %>
              <div class="flex flex-col items-center rounded-lg px-3 py-2 min-w-[52px]" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px);">
                <span data-countdown-target="<%= unit %>" class="font-display text-xl font-semibold text-white tabular-nums">00</span>
                <span class="text-[8px] font-medium uppercase tracking-wider" style="color: rgba(255,255,255,0.4);"><%= unit %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Product row -->
        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          <% @running_flash_sale_products.limit(10).each do |product| %>
            <% variant = product.master_variant %>
            <% if variant %>
              <%= link_to product_path(product), class: "group block overflow-hidden rounded-xl transition-transform duration-300 hover:-translate-y-1", style: "background: rgba(255,255,255,0.05); backdrop-filter: blur(10px);" do %>
                <div class="aspect-square overflow-hidden">
                  <% if product.images.attached? %>
                    <%= image_tag product.images.first, class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" %>
                  <% else %>
                    <div class="h-full w-full" style="background: rgba(255,255,255,0.05);"></div>
                  <% end %>
                </div>
                <div class="p-3">
                  <p class="text-xs font-medium text-white truncate"><%= product.name %></p>
                  <div class="mt-1.5 flex items-center gap-2">
                    <span class="font-display text-sm font-semibold" style="color: #fda4af;"><%= variant.current_price.format %></span>
                    <span class="text-[10px] line-through" style="color: rgba(255,255,255,0.35);"><%= variant.price.format %></span>
                  </div>
                  <% if @running_flash_sale.discount_percentage > 0 %>
                    <span class="mt-2 inline-block rounded-full px-2 py-0.5 text-[9px] font-bold text-white" style="background: #e11d48;">
                      -<%= @running_flash_sale.discount_percentage %>%
                    </span>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% elsif @upcoming_flash_sale %>
    <section style="background: linear-gradient(135deg, #12100c 0%, #1a1510 100%);">
      <div class="mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-12 lg:py-12">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
             data-controller="countdown"
             data-countdown-ends-at-value="<%= @upcoming_flash_sale.starts_at.iso8601 %>">
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-widest" style="color: var(--gold);">Upcoming Flash Sale</span>
            <h3 class="mt-1 font-display text-2xl font-light text-white"><%= @upcoming_flash_sale.name %></h3>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.5);">Starts in</span>
            <% %w[days hours minutes seconds].each do |unit| %>
              <div class="flex flex-col items-center rounded-lg px-2.5 py-1.5 min-w-[46px]" style="background: rgba(255,255,255,0.06);">
                <span data-countdown-target="<%= unit %>" class="font-display text-base font-semibold text-white tabular-nums">00</span>
                <span class="text-[8px] font-medium uppercase tracking-wider" style="color: rgba(255,255,255,0.4);"><%= unit %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- ═══════════════════════════════════════════════════════════════════
       AD STRIP - Mid-page promo tiles (2-up)
       ═══════════════════════════════════════════════════════════════════ -->
  <% if @ads_mid.any? %>
    <section style="background: var(--warm-white);">
      <div class="mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-12">
        <div class="grid gap-4 sm:grid-cols-2">
          <% @ads_mid.each do |ad| %>
            <%= link_to (ad.link_url.presence || "#"), class: "group relative block overflow-hidden rounded-2xl shadow-sm ring-1 ring-gray-900/5" do %>
              <div class="aspect-[21/9]">
                <% if ad.image.attached? %>
                  <%= image_tag ad.image, class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" %>
                <% else %>
                  <div class="h-full w-full" style="background: linear-gradient(135deg, var(--cream) 0%, #e6e0d5 100%);"></div>
                <% end %>
              </div>
              <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(8,8,8,0.7) 0%, rgba(8,8,8,0.2) 60%, transparent 100%);"></div>
              <div class="absolute inset-0 flex flex-col justify-center px-8">
                <h3 class="font-display text-2xl font-light text-white sm:text-3xl"><%= ad.title %></h3>
                <% if ad.subtitle.present? %>
                  <p class="mt-1 text-sm" style="color: rgba(255,255,255,0.75);"><%= ad.subtitle %></p>
                <% end %>
                <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest" style="color: var(--gold);">
                  Shop now
                  <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- ═══════════════════════════════════════════════════════════════════
       BRAND STRIP - Featured brand logos
       ═══════════════════════════════════════════════════════════════════ -->
  <% if @featured_brands.any? %>
    <section style="background: var(--warm-white);">
      <div class="mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-12">
        <div class="flex items-center justify-between mb-6">
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.3em]" style="color: var(--gold);">Shop by Brand</span>
            <h2 class="mt-1 font-display text-2xl font-light" style="color: var(--black);">Trusted Brands</h2>
          </div>
          <%= link_to "View all →", products_path, class: "text-xs font-semibold uppercase tracking-wider hover:opacity-70", style: "color: var(--black);" %>
        </div>
        <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
          <% @featured_brands.each do |brand| %>
            <%= link_to products_path(brand: brand.slug),
              class: "group flex h-20 items-center justify-center rounded-xl border bg-white px-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md",
              style: "border-color: rgba(0,0,0,0.06);" do %>
              <% if brand.logo.attached? %>
                <%= image_tag brand.logo, class: "max-h-10 max-w-full object-contain opacity-70 transition-opacity duration-300 group-hover:opacity-100" %>
              <% else %>
                <span class="font-display text-sm font-semibold" style="color: var(--mid-gray);"><%= brand.name %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- ═══════════════════════════════════════════════════════════════════
       POPULAR RIGHT NOW - Products shown immediately
       ═══════════════════════════════════════════════════════════════════ -->
  <% if @popular_products.any? %>
    <section style="background: var(--warm-white);">
      <div class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-12 lg:py-20">
        <div class="flex items-end justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em]" style="color: var(--gold);">Discover</p>
            <h2 class="mt-2 font-display text-3xl font-light tracking-tight sm:text-4xl" style="color: var(--black);">Popular <em class="italic">Right Now</em></h2>
          </div>
          <%= link_to products_path, class: "hidden items-center gap-2 text-sm font-medium transition-colors sm:flex hover:opacity-70", style: "color: var(--black);" do %>
            Shop All
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          <% end %>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
          <% @popular_products.each do |product| %>
            <%= render "storefront/products/product_card", product: product %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- ═══════════════════════════════════════════════════════════════════
       TRENDING CATEGORIES - Large visual cards
       ═══════════════════════════════════════════════════════════════════ -->
  <% if @categories.any? %>
    <% category_images = {
      "Clothing" => "https://images.unsplash.com/photo-1445205170230-053b83016050?w=600&q=80",
      "Electronics" => "https://images.unsplash.com/photo-1468495244123-6c6c332eeece?w=600&q=80",
      "Home & Living" => "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&q=80",
      "Sports & Outdoors" => "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=600&q=80",
      "Accessories" => "https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=600&q=80",
      "Beauty & Wellness" => "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&q=80",
      "Books & Media" => "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=600&q=80",
      "Groceries" => "https://images.unsplash.com/photo-1542838132-92c53300491e?w=600&q=80",
      "Toys & Games" => "https://images.unsplash.com/photo-1558060370-d644479cb6f7?w=600&q=80",
      "Automotive" => "https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=600&q=80",
      "Garden & DIY" => "https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600&q=80",
      "Pet Supplies" => "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600&q=80"
    } %>
    <% fallback_images = [
      "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&q=80",
      "https://images.unsplash.com/photo-1472851294608-062f824d29cc?w=600&q=80",
      "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600&q=80",
      "https://images.unsplash.com/photo-1555529669-e69e7aa0ba9a?w=600&q=80",
      "https://images.unsplash.com/photo-1607082349566-187342175e2f?w=600&q=80",
      "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600&q=80"
    ] %>
    <% category_gradients = [
      "linear-gradient(135deg, #1a1510 0%, #0f0d0a 100%)",
      "linear-gradient(135deg, #0f1923 0%, #0a1018 100%)",
      "linear-gradient(135deg, #1c1a15 0%, #12110d 100%)",
      "linear-gradient(135deg, #0d1a12 0%, #091009 100%)",
      "linear-gradient(135deg, #1a1520 0%, #100d15 100%)",
      "linear-gradient(135deg, #1a1015 0%, #120a0f 100%)"
    ] %>
    <section id="categories" class="py-20 lg:py-28" style="background: var(--warm-white);">
