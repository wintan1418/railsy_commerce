<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Banners</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @banners.count %> total · shown in the homepage hero slideshow</p>
  </div>
  <%= link_to "New Banner", new_admin_banner_path,
    class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors duration-200" %>
</div>

<div class="mt-6 overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <thead>
        <tr class="bg-gray-50/50">
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Image</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Title</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Link</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Schedule</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Position</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @banners.each do |banner| %>
          <tr class="hover:bg-gray-50/50 transition-colors duration-150">
            <td class="px-6 py-4">
              <% if banner.image.attached? %>
                <%= image_tag banner.image, class: "h-12 w-20 rounded object-cover ring-1 ring-gray-200" %>
              <% else %>
                <div class="h-12 w-20 rounded bg-gray-100 ring-1 ring-gray-200 flex items-center justify-center text-xs text-gray-400">No image</div>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm font-semibold text-gray-900">
              <%= banner.title %>
              <% if banner.subtitle.present? %>
                <div class="text-xs font-normal text-gray-500 mt-0.5"><%= truncate(banner.subtitle, length: 60) %></div>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <% if banner.link_url.present? %>
                <span class="font-mono text-xs"><%= truncate(banner.link_url, length: 30) %></span>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-xs text-gray-500">
              <% if banner.starts_at || banner.ends_at %>
                <% if banner.starts_at %><div>from <%= banner.starts_at.strftime("%b %-d") %></div><% end %>
                <% if banner.ends_at %><div>until <%= banner.ends_at.strftime("%b %-d") %></div><% end %>
              <% else %>
                <span class="text-gray-300">Always on</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= banner.position %></td>
            <td class="whitespace-nowrap px-6 py-4">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                <%= banner.active? ? 'bg-green-50 text-green-700 ring-1 ring-green-600/20' : 'bg-gray-50 text-gray-600 ring-1 ring-gray-500/20' %>">
                <%= banner.active? ? "Active" : "Disabled" %>
              </span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right space-x-3">
              <%= button_to (banner.active? ? "Disable" : "Enable"), toggle_admin_banner_path(banner),
                method: :post, form: { class: "inline" },
                class: "text-sm font-medium text-gray-600 hover:text-gray-900 cursor-pointer bg-transparent" %>
              <%= link_to "Edit", edit_admin_banner_path(banner), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= link_to "Delete", admin_banner_path(banner), data: { turbo_method: :delete, turbo_confirm: "Delete this banner?" },
                class: "text-sm font-medium text-red-600 hover:text-red-500" %>
            </td>
          </tr>
        <% end %>
        <% if @banners.empty? %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400">
              No banners yet. <%= link_to "Create your first banner", new_admin_banner_path, class: "text-indigo-600 font-medium hover:underline" %>.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
