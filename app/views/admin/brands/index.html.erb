<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Brands</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @brands.count %> total · featured brands appear on the homepage strip</p>
  </div>
  <%= link_to "New Brand", new_admin_brand_path,
    class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors duration-200" %>
</div>

<div class="mt-6 overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <thead>
        <tr class="bg-gray-50/50">
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Logo</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Products</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Featured</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @brands.each do |brand| %>
          <tr class="hover:bg-gray-50/50 transition-colors duration-150">
            <td class="px-6 py-4">
              <% if brand.logo.attached? %>
                <%= image_tag brand.logo, class: "h-10 w-20 rounded object-contain bg-gray-50 ring-1 ring-gray-200 p-1" %>
              <% else %>
                <div class="h-10 w-20 rounded bg-gray-100 ring-1 ring-gray-200 flex items-center justify-center text-[10px] text-gray-400">No logo</div>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm font-semibold text-gray-900">
              <%= brand.name %>
              <% if brand.description.present? %>
                <div class="text-xs font-normal text-gray-500 mt-0.5"><%= truncate(brand.description, length: 60) %></div>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= brand.products_count %></td>
            <td class="px-6 py-4">
              <%= button_to (brand.featured? ? "★ Featured" : "☆ Feature"),
                toggle_featured_admin_brand_path(brand), method: :post,
                form: { class: "inline" },
                class: "text-xs font-semibold cursor-pointer bg-transparent #{brand.featured? ? 'text-amber-600' : 'text-gray-400 hover:text-amber-600'}" %>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                <%= brand.active? ? 'bg-green-50 text-green-700 ring-1 ring-green-600/20' : 'bg-gray-50 text-gray-600 ring-1 ring-gray-500/20' %>">
                <%= brand.active? ? "Active" : "Disabled" %>
              </span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_brand_path(brand), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= link_to "Delete", admin_brand_path(brand), data: { turbo_method: :delete, turbo_confirm: "Delete this brand? Products will be unlinked." },
                class: "text-sm font-medium text-red-600 hover:text-red-500" %>
            </td>
          </tr>
        <% end %>
        <% if @brands.empty? %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-sm text-gray-400">
              No brands yet. <%= link_to "Create your first brand", new_admin_brand_path, class: "text-indigo-600 font-medium hover:underline" %>.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
