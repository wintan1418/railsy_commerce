<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.25em]" style="color: var(--gold);">My Account</p>
    <h1 class="mt-1 font-display text-3xl font-light tracking-tight" style="color: var(--black);">Digital Library</h1>
    <p class="mt-2 text-sm" style="color: var(--mid-gray);">Downloads from your digital purchases.</p>
  </div>

  <% if @downloads.any? %>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @downloads.each do |download| %>
        <% product = download.product %>
        <div class="group flex flex-col rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-900/5 transition-transform duration-200 hover:-translate-y-0.5">
          <div class="flex items-start gap-4">
            <div class="h-16 w-16 flex-shrink-0 rounded-lg overflow-hidden" style="background: var(--cream);">
              <% if product.images.attached? %>
                <%= image_tag product.images.first, class: "h-full w-full object-cover" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center">
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--mid-gray);">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold truncate" style="color: var(--black);"><%= product.name %></p>
              <p class="mt-0.5 text-xs" style="color: var(--mid-gray);">
                Order #<%= download.order.number %>
              </p>
              <p class="mt-0.5 text-xs" style="color: var(--mid-gray);">
                <%= download.download_count %> download<%= 's' unless download.download_count == 1 %>
              </p>
            </div>
          </div>

          <% files = download.files %>
          <% if files.any? %>
            <div class="mt-4 space-y-2">
              <% files.each do |file| %>
                <%= link_to account_digital_download_path(download, file_id: file.id),
                  class: "flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium transition-colors",
                  style: "background: var(--cream); color: var(--black);" do %>
                  <span class="truncate"><%= file.filename.to_s %></span>
                  <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="mt-4 text-xs italic" style="color: var(--mid-gray);">No files available yet.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-10 rounded-xl bg-white p-12 text-center shadow-sm ring-1 ring-gray-900/5">
      <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" style="color: var(--light-gray);">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
      </svg>
      <p class="mt-4 text-sm" style="color: var(--mid-gray);">No digital downloads yet.</p>
      <%= link_to "Browse digital products", products_path, class: "mt-4 inline-block text-sm font-semibold", style: "color: var(--gold);" %>
    </div>
  <% end %>
</div>
