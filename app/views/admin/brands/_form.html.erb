<%= form_with model: [:admin, brand], class: "space-y-6" do |form| %>
  <% if brand.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="text-sm text-red-800">
        <% brand.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Name <span class="text-red-500">*</span></label>
      <%= form.text_field :name, required: true, placeholder: "Sony", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Description</label>
      <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Website</label>
      <%= form.url_field :website, placeholder: "https://", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <h3 class="text-sm font-semibold text-gray-900">Logo</h3>
    <% if brand.logo.attached? %>
      <div class="flex items-center gap-4">
        <%= image_tag brand.logo, class: "h-20 w-40 rounded object-contain bg-gray-50 ring-1 ring-gray-200 p-2" %>
        <p class="text-xs text-gray-500">Upload a new file to replace.<br>Recommended: transparent PNG or SVG, 400×200.</p>
      </div>
    <% end %>
    <%= form.file_field :logo, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 grid grid-cols-3 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Position</label>
      <%= form.number_field :position, min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>
    <div class="flex items-center pt-6">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <label class="ml-2 text-sm font-medium text-gray-700">Active</label>
    </div>
    <div class="flex items-center pt-6">
      <%= form.check_box :featured, class: "h-4 w-4 rounded border-gray-300 text-amber-500 focus:ring-amber-500" %>
      <label class="ml-2 text-sm font-medium text-gray-700">Featured on homepage</label>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_brands_path, class: "rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-200 hover:bg-gray-50" %>
    <%= form.submit class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
