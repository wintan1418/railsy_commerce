<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Ads</h1>
    <p class="mt-1 text-sm text-gray-500">Promo tiles rendered between homepage sections</p>
  </div>
  <%= link_to "New Ad", new_admin_ad_path,
    class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
</div>

<% Ad::PLACEMENTS.each do |placement| %>
  <% ads = @ads[placement] || [] %>
  <div class="mt-6 rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="flex items-center justify-between border-b border-gray-100 px-6 py-3">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-700"><%= placement.humanize %></h2>
      <span class="text-xs text-gray-400"><%= ads.count %> ads</span>
    </div>
    <% if ads.any? %>
      <table class="min-w-full divide-y divide-gray-100">
        <tbody class="divide-y divide-gray-100">
          <% ads.each do |ad| %>
            <tr class="hover:bg-gray-50/50">
              <td class="px-6 py-3 w-28">
                <% if ad.image.attached? %>
                  <%= image_tag ad.image, class: "h-14 w-24 rounded object-cover ring-1 ring-gray-200" %>
                <% else %>
                  <div class="h-14 w-24 rounded bg-gray-100 ring-1 ring-gray-200 flex items-center justify-center text-[10px] text-gray-400">No image</div>
                <% end %>
              </td>
              <td class="px-6 py-3 text-sm font-semibold text-gray-900">
                <%= ad.title %>
                <% if ad.subtitle.present? %>
                  <div class="text-xs font-normal text-gray-500 mt-0.5"><%= truncate(ad.subtitle, length: 60) %></div>
                <% end %>
              </td>
              <td class="px-6 py-3 text-xs text-gray-500">
                <% if ad.link_url.present? %>
                  <span class="font-mono"><%= truncate(ad.link_url, length: 30) %></span>
                <% end %>
              </td>
              <td class="px-6 py-3 text-sm text-gray-500">pos <%= ad.position %></td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= ad.active? ? 'bg-green-50 text-green-700 ring-1 ring-green-600/20' : 'bg-gray-50 text-gray-600 ring-1 ring-gray-500/20' %>">
                  <%= ad.active? ? "Active" : "Disabled" %>
                </span>
              </td>
              <td class="px-6 py-3 text-right space-x-3">
                <%= button_to (ad.active? ? "Disable" : "Enable"), toggle_admin_ad_path(ad),
                  method: :post, form: { class: "inline" },
                  class: "text-sm font-medium text-gray-600 hover:text-gray-900 cursor-pointer bg-transparent" %>
                <%= link_to "Edit", edit_admin_ad_path(ad), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
                <%= link_to "Delete", admin_ad_path(ad), data: { turbo_method: :delete, turbo_confirm: "Delete this ad?" },
                  class: "text-sm font-medium text-red-600 hover:text-red-500" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-6 text-center text-sm text-gray-400">No ads in this slot.</p>
    <% end %>
  </div>
<% end %>
