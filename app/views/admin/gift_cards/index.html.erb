<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Gift Cards</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @gift_cards.count %> issued · customers redeem at checkout</p>
  </div>
  <%= link_to "Issue Gift Card", new_admin_gift_card_path,
    class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
</div>

<div class="mt-6 overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <thead>
        <tr class="bg-gray-50/50">
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Code</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Recipient</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Initial</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Balance</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Expires</th>
          <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @gift_cards.each do |gc| %>
          <tr class="hover:bg-gray-50/50">
            <td class="px-6 py-4 text-sm font-mono text-gray-900"><%= gc.code %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= gc.recipient_email.presence || "—" %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= gc.initial_balance.format %></td>
            <td class="px-6 py-4 text-sm font-semibold text-gray-900"><%= gc.balance.format %></td>
            <td class="px-6 py-4 text-xs text-gray-500"><%= gc.expires_at&.strftime("%b %-d, %Y") || "Never" %></td>
            <td class="px-6 py-4">
              <%
                state, classes = if !gc.active?
                  [ "Disabled", "bg-gray-100 text-gray-600 ring-gray-500/20" ]
                elsif gc.expired?
                  [ "Expired", "bg-gray-100 text-gray-600 ring-gray-500/20" ]
                elsif gc.depleted?
                  [ "Depleted", "bg-gray-100 text-gray-600 ring-gray-500/20" ]
                else
                  [ "Active", "bg-green-50 text-green-700 ring-green-600/20" ]
                end
              %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 <%= classes %>"><%= state %></span>
            </td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "View", admin_gift_card_path(gc), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= link_to "Edit", edit_admin_gift_card_path(gc), class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
              <%= link_to "Delete", admin_gift_card_path(gc), data: { turbo_method: :delete, turbo_confirm: "Delete gift card?" }, class: "text-sm font-medium text-red-600 hover:text-red-500" %>
            </td>
          </tr>
        <% end %>
        <% if @gift_cards.empty? %>
          <tr><td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400">No gift cards yet. <%= link_to "Issue your first gift card", new_admin_gift_card_path, class: "text-indigo-600 font-medium hover:underline" %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
