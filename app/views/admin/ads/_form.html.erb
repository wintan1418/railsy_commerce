<%= form_with model: [:admin, ad], class: "space-y-6" do |form| %>
  <% if ad.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="text-sm text-red-800">
        <% ad.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Title <span class="text-red-500">*</span></label>
      <%= form.text_field :title, required: true, placeholder: "Summer Collection", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Subtitle</label>
      <%= form.text_field :subtitle, placeholder: "Up to 40% off", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Link URL</label>
      <%= form.text_field :link_url, placeholder: "/products?sale=true", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Placement <span class="text-red-500">*</span></label>
        <%= form.select :placement, Ad::PLACEMENTS.map { |p| [ p.humanize, p ] }, {}, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Position</label>
        <%= form.number_field :position, min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
      </div>
    </div>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 space-y-4">
    <h3 class="text-sm font-semibold text-gray-900">Image</h3>
    <% if ad.image.attached? %>
      <%= image_tag ad.image, class: "h-28 w-56 rounded object-cover ring-1 ring-gray-200" %>
    <% end %>
    <%= form.file_field :image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Starts at</label>
      <%= form.datetime_local_field :starts_at, value: ad.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Ends at</label>
      <%= form.datetime_local_field :ends_at, value: ad.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
    </div>
    <div class="col-span-2 flex items-center">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600" %>
      <label class="ml-2 text-sm font-medium text-gray-700">Active</label>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_ads_path, class: "rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-200 hover:bg-gray-50" %>
    <%= form.submit class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
